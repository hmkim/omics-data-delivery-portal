{
  "name": "@genome-portal/web",
  "version": "0.1.0",
  "private": true,
  "description": "Genome data delivery portal SPA (Vite + React + Amplify Storage Browser)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "copy-sw": "copy-serviceworker public",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:firefox": "playwright test --project=firefox",
    "e2e:report": "playwright show-report",
    "e2e:athena-check": "tsx e2e/scripts/athena-cache-check.ts"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.6",
    "@aws-amplify/ui-react-storage": "^3.18.2",
    "@genome-portal/contract": "*",
    "aws-amplify": "^6.22.0",
    "client-zip": "^2.5.1",
    "hash-wasm": "^4.12.0",
    "i18next": "^26.4.2",
    "idb": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1141.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "vite": "^8.3.1"
  }
}
