{
  "name": "@genome-portal/infra",
  "version": "0.1.0",
  "private": true,
  "description": "CDK application (7 stacks) and Lambda handlers for the genome data delivery portal",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "synth": "cdk synth -c env=dev -c account=111111111111 --quiet",
    "synth:dev": "cdk synth -c env=dev --quiet",
    "deploy:dev": "cdk deploy --all -c env=dev --require-approval never",
    "cdk": "cdk"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "^3.1141.0",
    "@aws-sdk/client-cloudfront": "^3.1141.0",
    "@aws-sdk/client-cloudwatch": "^3.1141.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-s3-control": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/cloudfront-signer": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@genome-portal/contract": "*",
    "aws-cdk-lib": "^2.200.0",
    "cdk-nag": "^2.30.0",
    "constructs": "^10.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1141.0",
    "@aws-sdk/client-cloudtrail": "^3.1141.0",
    "@aws-sdk/client-lambda": "^3.1141.0",
    "@aws-sdk/credential-provider-env": "^3.972.72",
    "@aws-sdk/credential-provider-ini": "^3.973.17",
    "@types/aws-lambda": "^8.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "aws-amplify": "^6.22.0",
    "aws-cdk": "^2.1000.0",
    "aws-sdk-client-mock": "^4.0.0",
    "aws-sdk-client-mock-vitest": "^6.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0"
  }
}
